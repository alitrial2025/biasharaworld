# Use the same Supabase project for the client and server.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Production Supabase HTTPS origin, used in Vercel Preview to protect production from sandbox writes.
BIASHARA_PRODUCTION_SUPABASE_URL=
# HTTPS public origin for callbacks. Vercel can derive this from its system variables.
NEXT_PUBLIC_APP_URL=

# Server only. Put the value in ignored .env.local or your hosting secret settings.
SUPABASE_SECRET_KEY=

# Optional HTTPS link to the signed Android release, set before building the site.
ANDROID_RELEASE_DOWNLOAD_URL=

# Separate Didit KYC and KYB workflows, with the shared webhook secret from that application.
DIDIT_WORKFLOW_ID=
DIDIT_COMPANY_WORKFLOW_ID=
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=

# Paystack Kenya. Use a test secret in staging and a live secret in production.
PAYSTACK_SECRET_KEY=
# Turn on only after Paystack confirms and staging verifies Kenyan bank transfer with merchant settlement.
PAYSTACK_BANK_TRANSFERS=false
# Optional override for the HTTPS callback origin.
PAYSTACK_CALLBACK_ORIGIN=
