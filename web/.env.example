# Public Supabase client settings for the backend phase.
# Configure actual values only after the intended hosted project has been selected.
# The UI currently still uses the existing local demo store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Site origin used when implementing confirmation/password-reset redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Never place Supabase secret/service-role keys or CLI management tokens here.
